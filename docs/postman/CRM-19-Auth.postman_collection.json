{
  "info": {
    "name": "Support Resolution Copilot - Auth (CRM-19)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "email", "value": "admin@example.com" },
    { "key": "password", "value": "Admin@123" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns bearer access_token', () => {",
                  "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.token_type).to.eql('bearer');",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "GET /api/auth/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns user info', () => {",
                  "  const u = pm.response.json();",
                  "  pm.expect(u).to.have.keys('id', 'email', 'role', 'full_name');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Run login first. Remove/alter the Authorization header to verify 401 Unauthorized."
          }
        },
        {
          "name": "GET /api/auth/admin/ping (RBAC check)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK for admin', () => pm.response.to.have.status(200));",
                  "pm.test('returns pong', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('pong');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/ping",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "admin", "ping"]
            },
            "description": "Protected by require_role('admin'). Returns 200 OK for admin, 403 Forbidden for other roles, 401 Unauthorized without token."
          }
        }
      ]
    }
  ]
}
