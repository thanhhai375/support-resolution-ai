<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Auto" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Auto_Support" name="Quy trình AI tự động xử lý Ticket" isExecutable="true">
    <bpmn:startEvent id="Start_Ticket" name="Khách gửi Ticket">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Categorize" name="Tự động phân loại Ticket">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AIEval" name="AI tạo phản hồi &amp; Đánh giá chất lượng">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AIDecision" name="Phản hồi đạt chuẩn?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F_Valid</bpmn:outgoing>
      <bpmn:outgoing>F_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AutoSend" name="Tự động gửi phản hồi &amp; Đóng Ticket">
      <bpmn:incoming>F_Valid</bpmn:incoming>
      <bpmn:outgoing>F_End1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Escalate" name="Gắn cờ chuyển nhân viên xử lý">
      <bpmn:incoming>F_Invalid</bpmn:incoming>
      <bpmn:outgoing>F_End2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Closed" name="Hoàn tất xử lý Ticket">
      <bpmn:incoming>F_End1</bpmn:incoming>
      <bpmn:incoming>F_End2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Ticket" targetRef="Task_Categorize" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Categorize" targetRef="Task_AIEval" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_AIEval" targetRef="Gateway_AIDecision" />
    <bpmn:sequenceFlow id="F_Valid" name="Đạt" sourceRef="Gateway_AIDecision" targetRef="Task_AutoSend" />
    <bpmn:sequenceFlow id="F_Invalid" name="Không đạt" sourceRef="Gateway_AIDecision" targetRef="Task_Escalate" />
    <bpmn:sequenceFlow id="F_End1" sourceRef="Task_AutoSend" targetRef="End_Closed" />
    <bpmn:sequenceFlow id="F_End2" sourceRef="Task_Escalate" targetRef="End_Closed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Auto">
    <bpmndi:BPMNPlane id="BPMNPlane_Auto" bpmnElement="Process_Auto_Support">
      <bpmndi:BPMNShape id="Start_Ticket_di" bpmnElement="Start_Ticket">
        <dc:Bounds x="160" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="135" y="145" width="87" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Categorize_di" bpmnElement="Task_Categorize">
        <dc:Bounds x="250" y="80" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AIEval_di" bpmnElement="Task_AIEval">
        <dc:Bounds x="410" y="80" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AIDecision_di" bpmnElement="Gateway_AIDecision" isMarkerVisible="true">
        <dc:Bounds x="590" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="575" y="60" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AutoSend_di" bpmnElement="Task_AutoSend">
        <dc:Bounds x="700" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Escalate_di" bpmnElement="Task_Escalate">
        <dc:Bounds x="700" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Closed_di" bpmnElement="End_Closed">
        <dc:Bounds x="872" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="850" y="145" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="196" y="120" /><di:waypoint x="250" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="360" y="120" /><di:waypoint x="410" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="540" y="120" /><di:waypoint x="590" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Valid_di" bpmnElement="F_Valid"><di:waypoint x="640" y="120" /><di:waypoint x="700" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Invalid_di" bpmnElement="F_Invalid"><di:waypoint x="615" y="145" /><di:waypoint x="615" y="240" /><di:waypoint x="700" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_End1_di" bpmnElement="F_End1"><di:waypoint x="820" y="120" /><di:waypoint x="872" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_End2_di" bpmnElement="F_End2"><di:waypoint x="820" y="240" /><di:waypoint x="890" y="240" /><di:waypoint x="890" y="138" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
