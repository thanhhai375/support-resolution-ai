<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Copilot" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Copilot_Support" name="Quy trình Copilot có kiểm duyệt" isExecutable="true">
    <bpmn:startEvent id="Start_Ticket" name="Khách gửi Ticket">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_SafetyCheck" name="Kiểm tra an toàn khẩn cấp">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Safety" name="Có nguy cơ cháy nổ / điện giật?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F_Safe</bpmn:outgoing>
      <bpmn:outgoing>F_Danger</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Escalate" name="Chuyển khẩn cấp cho nhân viên có chuyên môn (Escalate)">
      <bpmn:incoming>F_Danger</bpmn:incoming>
      <bpmn:outgoing>F_EndEscalated</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Escalated" name="Đã chuyển khẩn cấp">
      <bpmn:incoming>F_EndEscalated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Retrieve" name="AI phân loại &amp; trích xuất tài liệu đã duyệt">
      <bpmn:incoming>F_Safe</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Draft" name="AI tạo bản nháp gợi ý">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Approve" name="Nhân viên kỹ thuật duyệt / chỉnh sửa (bắt buộc)">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SendClose" name="Nhân viên gửi phản hồi &amp; Đóng ticket">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Done" name="Hoàn tất xử lý Ticket">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Ticket" targetRef="Task_SafetyCheck" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_SafetyCheck" targetRef="Gateway_Safety" />
    <bpmn:sequenceFlow id="F_Safe" name="Không" sourceRef="Gateway_Safety" targetRef="Task_Retrieve" />
    <bpmn:sequenceFlow id="F_Danger" name="Có" sourceRef="Gateway_Safety" targetRef="Task_Escalate" />
    <bpmn:sequenceFlow id="F_EndEscalated" sourceRef="Task_Escalate" targetRef="End_Escalated" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Retrieve" targetRef="Task_Draft" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Draft" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Approve" targetRef="Task_SendClose" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_SendClose" targetRef="End_Done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Copilot">
    <bpmndi:BPMNPlane id="BPMNPlane_Copilot" bpmnElement="Process_Copilot_Support">
      <bpmndi:BPMNShape id="Start_Ticket_di" bpmnElement="Start_Ticket">
        <dc:Bounds x="160" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="135" y="145" width="87" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SafetyCheck_di" bpmnElement="Task_SafetyCheck">
        <dc:Bounds x="250" y="80" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Safety_di" bpmnElement="Gateway_Safety" isMarkerVisible="true">
        <dc:Bounds x="400" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="365" y="50" width="120" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Retrieve_di" bpmnElement="Task_Retrieve">
        <dc:Bounds x="510" y="80" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Draft_di" bpmnElement="Task_Draft">
        <dc:Bounds x="690" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Approve_di" bpmnElement="Task_Approve">
        <dc:Bounds x="860" y="80" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendClose_di" bpmnElement="Task_SendClose">
        <dc:Bounds x="1040" y="80" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Done_di" bpmnElement="End_Done">
        <dc:Bounds x="1222" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1200" y="145" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Escalate_di" bpmnElement="Task_Escalate">
        <dc:Bounds x="510" y="200" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Escalated_di" bpmnElement="End_Escalated">
        <dc:Bounds x="722" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="700" y="265" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="196" y="120" /><di:waypoint x="250" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="360" y="120" /><di:waypoint x="400" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Safe_di" bpmnElement="F_Safe">
        <di:waypoint x="450" y="120" /><di:waypoint x="510" y="120" />
        <bpmndi:BPMNLabel><dc:Bounds x="465" y="102" width="34" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Danger_di" bpmnElement="F_Danger">
        <di:waypoint x="425" y="145" /><di:waypoint x="425" y="240" /><di:waypoint x="510" y="240" />
        <bpmndi:BPMNLabel><dc:Bounds x="433" y="190" width="14" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_EndEscalated_di" bpmnElement="F_EndEscalated"><di:waypoint x="660" y="240" /><di:waypoint x="722" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="640" y="120" /><di:waypoint x="690" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="810" y="120" /><di:waypoint x="860" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="990" y="120" /><di:waypoint x="1040" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1170" y="120" /><di:waypoint x="1222" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
